# ===== Unity 生成目录（可再生） =====
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
MemoryCaptures/
[Rr]ecordings/

# ===== Unity 生成文件 =====
sysinfo.txt
crashlytics-build.properties

# ===== IDE / 构建产物 =====
.vs/
.idea/
*.csproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.apk
*.aab
*.app
*.unitypackage
*.exe
*.mp4

# ===== Backend solution (tracked intentionally; Unity's generated project rules above are global) =====
!fps-backend/**/*.sln
!fps-backend/**/*.csproj
fps-backend/**/bin/
fps-backend/**/obj/

# ===== Codely CLI 运行时（由工具自动恢复，不入库） =====
.codely-cli/
.codely.packages/
/.codely/
/.com-unity-codely.json

# ===== TJGenerators 生成历史（插件自动留档，不入库） =====
/Assets/TJGenerators/History/

# ===== 截图 / 临时输出 =====
/screenshots/

# ===== 本地服务器启动器运行时（含 serverKey 密钥与进程状态，绝不入库） =====
Tools/Server/.runtime/

# ===== 本地客户端/服务器启动器日志（每客户端唯一 -logFile，仅本机排查用） =====
Tools/Client/Logs/
Tools/Server/Logs/

# ===== 热更新分发产物（发布脚本生成的版本目录与 manifest，本地文件服务内容，不入库） =====
# 后端 ContentRoot = fps-backend/src/UnityFps.Api，静态文件根在其下 hotupdate/
/fps-backend/src/UnityFps.Api/hotupdate/
/Logs/HotUpdate/releases/

# ===== Qoder 本地作用域配置（本机 localhost MCP 端点，仅本人生效，不入库） =====
/.qoder/settings.local.json

# ===== OS =====
Thumbs.db
.DS_Store
Desktop.ini

# ===== 本机工具状态与临时测试文件 =====
/.vscode/
/.zcode/
/.json
/chat-export-current-*.md
/UnityFpsLowPoly.slnx
/Assets/InitTestScene*.unity
/Assets/InitTestScene*.unity.meta
**/__pycache__/
*.pyc

# ===== .NET 测试与审计构建输出 =====
/stagea-bin*/
**/out_test*/
**/stagea-audit-bin/
**/TestResults/
*.trx
*.log

# ===== agent-relay 运行时状态（任务/信箱/调度留痕，不入库；状态卡快照在 Docs/交接/ 下单独提交） =====
/Docs/交接/_bridge/

# Official long-lived documentation only; historical reports stay at local paths.
/Docs/*
!/Docs/README.md
!/Docs/Architecture/
!/Docs/Development/
!/Docs/Operations/
!/Docs/Releases/
/AGENTS.md
/CODELY.md
/FULL_PROJECT_REVIEW.md
/Captures/
/.qoder/rules/
