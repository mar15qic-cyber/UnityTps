+    /// <summary>对 rewardEligible 玩家逐个套用结算引擎；任一失败返回 false（重复上报会自动补偿重放）。</summary>
+    private async Task<bool> ApplyResultRewardsAsync(MatchResultReportRequest request, CancellationToken cancellationToken)
+    {
+        var failures = 0;
+        foreach (var player in request.Players)
+        {
+            if (!player.RewardEligible) continue; // 终局前退出/确认掉线者不获奖励（Docs/26 §2.4），战绩仍留结果快照
+            try
+            {
+                await matches.SubmitAsync(player.UserId, new MatchSubmissionRequest
+                {
+                    ClientMatchId = $"ds-{request.MatchId}-{player.UserId}",
+                    Kills = player.Kills,
+                    Deaths = player.Deaths,
+                    DurationSeconds = request.DurationSeconds,
+                    IsWin = request.WinnerTeam is not null && request.WinnerTeam == player.TeamId,
+                    MatchId = request.MatchId,
+                    TeamId = player.TeamId,
+                }, cancellationToken);
+            }
+            catch (Exception ex)
+            {
+                failures++;
+                logger.LogError(ex, "[RoomFlow] RESULT_REWARD_FAILED match={MatchId} user={UserId}", request.MatchId, player.UserId);
+            }
+        }
+        return failures == 0;
+    }
