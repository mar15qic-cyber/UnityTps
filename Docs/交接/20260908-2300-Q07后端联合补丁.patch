+            logger.LogInformation("[RoomFlow] MATCH_RETURNING room={RoomCode} match={MatchId} by={UserId}",
+                room.RoomCode, matchId, userId);
+            chat.SendSystem(room.RoomCode, "比赛结束，正在返回等待房间");
+            return ToSnapshot(room, userId, null);
+        }, cancellationToken));
+    }
