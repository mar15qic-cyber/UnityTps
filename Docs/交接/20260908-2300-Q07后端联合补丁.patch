+    /// <summary>
+    /// 玩家返房 ack（Docs/27 §5.7）：区分"退战斗"与"退房"——只迁移房间状态，绝不清空成员。
+    /// KillRace 路径首个 ack 使 InMatch→Returning（幂等：后续 ack 均 200）；TDM 通常已由 DS 终局上报先行转入。
+    /// Returning→Waiting 由懒维护按 45s 超时统一处理（v1.1 简化：全员 ack 提前返回延后）。
+    /// </summary>
+    public async Task<RoomSnapshotDto> ReturnAsync(long userId, string roomCode, string matchId, CancellationToken cancellationToken)
+    {
+        var normalized = (roomCode ?? string.Empty).Trim().ToUpperInvariant();
+        var strategy = db.Database.CreateExecutionStrategy();
+        return await strategy.ExecuteAsync(async () => await ExecuteInTransactionAsync(async () =>
+        {
+            var (room, _) = await LoadRoomAndMemberAsync(normalized, userId, cancellationToken, includeInstance: true);
+            var status = RoomStatus.Normalize(room.Status);
+            if (status == RoomStatus.Returning)
+                return ToSnapshot(room, userId, null); // 幂等：重复 ack 零副作用
+            if (room.CurrentMatchId != matchId)
+                throw new ApiException(StatusCodes.Status409Conflict, ApiErrorCodes.RoomStateConflict, "比赛身份与当前房间不符");
+            if (status is not (RoomStatus.InMatch or RoomStatus.Starting))
+                throw new ApiException(StatusCodes.Status409Conflict, ApiErrorCodes.RoomStateConflict, "房间当前不可返房");
+
+            room.Status = RoomStatus.Returning;
+            room.RoomVersion++;
+            room.StateChangedAtUtc = DateTime.UtcNow;
+            ReleaseInstanceUnsafe(room); // 比赛结束释放 DS（下一局重租，Docs/26 §2.2）
